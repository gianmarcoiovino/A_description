<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Sostituisci 'link_ee' (o il nome corretto dell'ultimo link del tuo braccio) come parent -->
    <joint name="wrist_camera_joint" type="fixed">
        <parent link="wrist"/> 
        <child link="wrist_camera_link"/>
        <origin xyz="0.0 0.0 0.05" rpy="0 -1.5708 0"/>
    </joint>

<link name="wrist_camera_link">
        <visual>
            <geometry>
                <!-- Modifica qui le dimensioni: [lunghezza, larghezza, altezza] -->
                <box size="0.015 0.02 0.02"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <joint name="wrist_camera_optical_joint" type="fixed">
        <parent link="wrist_camera_link"/>
        <child link="wrist_camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <link name="wrist_camera_optical_frame"/>

    <!-- ==== Plugin Sensore per il Polso ==== -->
    <gazebo reference="wrist_camera_link">
        <sensor name="wrist_camera" type="camera">
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>1280</width>
                    <height>720</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>3</far>
                </clip>
            </camera>
            <always_on>1</always_on>
            <update_rate>30</update_rate> 
            <visualize>true</visualize> 
            <topic>wrist_camera</topic>
            <gz_frame_id>wrist_camera_optical_frame</gz_frame_id> 
        </sensor>
    </gazebo>

</robot>